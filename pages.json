{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/me/me",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/selectd/selectd",
			"style": {
				"navigationBarTitleText": "精选"
			}
		},
		{
			"path": "pages/service/service",
			"style": {
				"navigationBarTitleText": "服务"
			}
		}
	],
	"tabBar": {
		"color": "#999999",
		"selectedColor": "#ffce2c",
		"backgroundColor": "#fff",
		"list": [
			{
				"text": "首页",
				"iconPath": "/static/common/images/home.png",
				"selectedIconPath": "/static/common/images/home-active.png",
				"pagePath": "pages/index/index"
			},
			{
				"text": "精选",
				"iconPath": "/static/common/images/sel.png",
				"selectedIconPath": "/static/common/images/sel-active.png",
				"pagePath": "pages/selectd/selectd"
			},
			{
				"text": "服务",
				"iconPath": "/static/common/images/service.png",
				"selectedIconPath": "/static/common/images/service-active.png",
				"pagePath": "pages/service/service"
			},
			{
				"text": "我的",
				"iconPath": "/static/common/images/me.png",
				"selectedIconPath": "/static/common/images/me-active.png",
				"pagePath": "pages/me/me"
			}
		]
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}
